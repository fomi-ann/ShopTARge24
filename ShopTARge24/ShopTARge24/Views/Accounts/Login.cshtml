@model ShopTARge24.Models.Accounts.LoginViewModel;

@{
    ViewBag.Title = "User Login";
}

<div class="row">
<div class="container col-6 ">
    <div class="border rounded p-4 bg-light">
        <div class="text-center">
            <h3>&#128526; &#128073; &#128187; &#128073; &#128521; </h3>
            <h3>Login</h3>
        </div>
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
                <div class="form-check">
                    <div class="checkbox">
                        <label asp-for="RememberMe">
                            <input asp-for="RememberMe" />
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>
                </div>
            <br />

            <button type="submit" class="btn btn-primary">
                Login
            </button>
            <div>
                <a asp-action="ForgotPassword">Forgot Password?</a>
            </div>
        </form>
    </div>
</div>
<div class="container col-6 ">
    <div class="border rounded p-4 bg-light">
        <div class="text-center">
                <h3>&#128187; &#128073; &#127756;</h3>
            <h3>External Login</h3>

                <form asp-controller="Accounts" asp-action="ExternalLogin" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]" method="post">
                    <div>
                        <button type="submit" class="btn btn-primary" name="provider" value="Google">
                            Log in with Google
                        </button>
                    </div>
                    <div>
                        <button type="submit"
                                class="btn btn-dark"
                                name="provider"
                                value="GitHub">
                            Log in with GitHub
                        </button>
                    </div>
                    <div>
                        <button type="submit"
                                class="btn btn-info"
                                name="provider"
                                value="Facebook">
                            Log in with Facebook
                        </button>
                    </div>
                </form>

        </div>
    </div>
</div>
</div>